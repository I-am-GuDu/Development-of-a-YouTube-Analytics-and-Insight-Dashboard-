# Copy this file to .env and fill in your own values.
# Never commit real secrets.

YOUTUBE_API_KEY=
# Cloudflare Workers AI — powers the AI Insights + Comment Sentiment features
# (free tier, model GLM 5.2). Create a Workers AI token in the Cloudflare
# dashboard. Leave the token blank to disable AI features.
CLOUDFLARE_API_TOKEN=
# Optional — auto-detected from the token if left blank. Found in the Cloudflare
# dashboard URL or the Workers AI page.
CLOUDFLARE_ACCOUNT_ID=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_analytics
DB_USER=postgres
DB_PASSWORD=
# Production uses a limited application role and sslmode=verify-full.
DATABASE_URL=
# Public site address used for the Google return URL. Leave blank locally
# (the browser's address is used). Must be listed in Neon Auth trusted domains.
APP_ORIGIN=https://ytvideoanalysis.studio
# Neon Auth URL (Neon console -> Auth). Enables "Continue with Google".
NEON_AUTH_URL=
# Set to false to hide the Google button.
AUTH_GOOGLE_ENABLED=true
